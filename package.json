{
	"name": "owenminercs-site",
	"private": true,
	"description": "Static site tooling (formatting). Pages remain plain HTML/CSS/JS.",
	"scripts": {
		"format": "prettier --write \"**/*.{html,css,js,json,md}\"",
		"format:check": "prettier --check \"**/*.{html,css,js,json,md}\"",
		"test:regression": "python3 -m unittest discover -s dev/regression -p \"test_*.py\"",
		"lint:css": "stylelint \"**/*.css\" --ignore-path .stylelintignore",
		"lint:html": "htmlhint \"**/*.html\" --ignore \".claude/**\""
	},
	"devDependencies": {
		"htmlhint": "^1.1.4",
		"prettier": "^3.5.3",
		"stylelint": "^16.19.1",
		"stylelint-config-recommended": "^15.0.0"
	}
}
